/* ============================================================
   FOLIUM QUANT DESK — Nord Theme (Oceanic Frost) QSS
   ============================================================
   Polar Night:  #2E3440  #3B4252  #434C5E  #4C566A
   Snow Storm:   #D8DEE9  #E5E9F0  #ECEFF4
   Frost:        #8FBCBB  #88C0D0  #81A1C1  #5E81AC
   Aurora:       #BF616A  #D08770  #EBCB8B  #A3BE8C  #B48EAD
   ============================================================ */

/* --- Global --- */
QWidget {
    background-color: #2E3440;
    color: #D8DEE9;
    font-family: "JetBrains Mono", "Fira Code", "Consolas", monospace;
    font-size: 13px;
    selection-background-color: #5E81AC;
    selection-color: #ECEFF4;
}

/* --- Main Window --- */
QMainWindow {
    background-color: #2E3440;
}

QMainWindow::separator {
    background-color: #3B4252;
    width: 2px;
    height: 2px;
}

/* --- Menu Bar --- */
QMenuBar {
    background-color: #3B4252;
    color: #D8DEE9;
    border-bottom: 1px solid #434C5E;
    padding: 2px;
}

QMenuBar::item {
    padding: 4px 12px;
    border-radius: 3px;
}

QMenuBar::item:selected {
    background-color: #434C5E;
    color: #88C0D0;
}

QMenu {
    background-color: #3B4252;
    border: 1px solid #434C5E;
    padding: 4px;
}

QMenu::item {
    padding: 6px 28px 6px 20px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #5E81AC;
    color: #ECEFF4;
}

QMenu::separator {
    height: 1px;
    background-color: #434C5E;
    margin: 4px 8px;
}

/* --- Tool Bar --- */
QToolBar {
    background-color: #3B4252;
    border-bottom: 1px solid #434C5E;
    spacing: 4px;
    padding: 2px;
}

QToolButton {
    background-color: transparent;
    color: #D8DEE9;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 10px;
    font-weight: 600;
}

QToolButton:hover {
    background-color: #434C5E;
    border-color: #88C0D0;
    color: #88C0D0;
}

QToolButton:pressed {
    background-color: #5E81AC;
    color: #ECEFF4;
}

QToolButton:checked {
    background-color: #5E81AC;
    color: #ECEFF4;
    border-color: #81A1C1;
}

/* --- Dock Widget --- */
QDockWidget {
    color: #88C0D0;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
    font-weight: bold;
}

QDockWidget::title {
    background-color: #3B4252;
    border: 1px solid #434C5E;
    padding: 6px;
    text-align: left;
}

QDockWidget::close-button,
QDockWidget::float-button {
    background-color: transparent;
    border: none;
    padding: 2px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: #434C5E;
    border-radius: 3px;
}

/* --- Tab Widget --- */
QTabWidget::pane {
    border: 1px solid #434C5E;
    background-color: #2E3440;
}

QTabBar::tab {
    background-color: #3B4252;
    color: #D8DEE9;
    border: 1px solid #434C5E;
    border-bottom: none;
    padding: 6px 16px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    font-weight: 600;
}

QTabBar::tab:selected {
    background-color: #2E3440;
    color: #88C0D0;
    border-bottom: 2px solid #88C0D0;
}

QTabBar::tab:hover:!selected {
    background-color: #434C5E;
    color: #81A1C1;
}

/* --- Table View --- */
QTableView, QTableWidget {
    background-color: #2E3440;
    alternate-background-color: #3B4252;
    gridline-color: #434C5E;
    border: 1px solid #434C5E;
    border-radius: 4px;
}

QTableView::item, QTableWidget::item {
    padding: 4px 8px;
}

QTableView::item:selected, QTableWidget::item:selected {
    background-color: #5E81AC;
    color: #ECEFF4;
}

QHeaderView::section {
    background-color: #3B4252;
    color: #81A1C1;
    border: 1px solid #434C5E;
    padding: 4px 8px;
    font-weight: bold;
    font-size: 12px;
}

/* --- Tree View --- */
QTreeView {
    background-color: #2E3440;
    alternate-background-color: #3B4252;
    border: 1px solid #434C5E;
    border-radius: 4px;
}

QTreeView::item:selected {
    background-color: #5E81AC;
    color: #ECEFF4;
}

QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    border-image: none;
}

/* --- Scroll Bars --- */
QScrollBar:vertical {
    background-color: #2E3440;
    width: 10px;
    margin: 0;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background-color: #4C566A;
    min-height: 30px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: #81A1C1;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #2E3440;
    height: 10px;
    margin: 0;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background-color: #4C566A;
    min-width: 30px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #81A1C1;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* --- Push Button --- */
QPushButton {
    background-color: #434C5E;
    color: #D8DEE9;
    border: 1px solid #4C566A;
    border-radius: 4px;
    padding: 6px 16px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #5E81AC;
    color: #ECEFF4;
    border-color: #81A1C1;
}

QPushButton:pressed {
    background-color: #81A1C1;
}

QPushButton:disabled {
    background-color: #3B4252;
    color: #4C566A;
    border-color: #3B4252;
}

/* --- Primary Action Button --- */
QPushButton#primaryButton {
    background-color: #5E81AC;
    color: #ECEFF4;
    border: none;
    font-weight: bold;
}

QPushButton#primaryButton:hover {
    background-color: #81A1C1;
}

/* --- Danger Button --- */
QPushButton#dangerButton {
    background-color: #BF616A;
    color: #ECEFF4;
    border: none;
}

QPushButton#dangerButton:hover {
    background-color: #D08770;
}

/* --- Line Edit --- */
QLineEdit {
    background-color: #3B4252;
    color: #ECEFF4;
    border: 1px solid #4C566A;
    border-radius: 4px;
    padding: 5px 10px;
}

QLineEdit:focus {
    border-color: #88C0D0;
}

QLineEdit:disabled {
    background-color: #2E3440;
    color: #4C566A;
}

/* --- Combo Box --- */
QComboBox {
    background-color: #3B4252;
    color: #D8DEE9;
    border: 1px solid #4C566A;
    border-radius: 4px;
    padding: 4px 10px;
}

QComboBox:hover {
    border-color: #88C0D0;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #3B4252;
    color: #D8DEE9;
    border: 1px solid #434C5E;
    selection-background-color: #5E81AC;
    selection-color: #ECEFF4;
}

/* --- Spin Box --- */
QSpinBox, QDoubleSpinBox {
    background-color: #3B4252;
    color: #D8DEE9;
    border: 1px solid #4C566A;
    border-radius: 4px;
    padding: 4px 8px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #88C0D0;
}

/* --- Progress Bar --- */
QProgressBar {
    background-color: #3B4252;
    border: 1px solid #434C5E;
    border-radius: 6px;
    height: 14px;
    text-align: center;
    color: #ECEFF4;
    font-size: 11px;
    font-weight: bold;
}

QProgressBar::chunk {
    background-color: #A3BE8C;
    border-radius: 5px;
}

/* --- Group Box --- */
QGroupBox {
    border: 1px solid #434C5E;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 16px;
    font-weight: bold;
    color: #88C0D0;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #88C0D0;
}

/* --- Label --- */
QLabel {
    color: #D8DEE9;
}

QLabel#headerLabel {
    color: #88C0D0;
    font-size: 18px;
    font-weight: bold;
}

QLabel#metricValue {
    color: #A3BE8C;
    font-size: 22px;
    font-weight: bold;
}

QLabel#metricLabel {
    color: #81A1C1;
    font-size: 11px;
}

QLabel#warningLabel {
    color: #EBCB8B;
}

QLabel#errorLabel {
    color: #BF616A;
}

/* --- Status Bar --- */
QStatusBar {
    background-color: #3B4252;
    color: #D8DEE9;
    border-top: 1px solid #434C5E;
    font-size: 12px;
}

QStatusBar::item {
    border: none;
}

/* --- Splitter --- */
QSplitter::handle {
    background-color: #434C5E;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

/* --- Text Edit / Plain Text --- */
QTextEdit, QPlainTextEdit {
    background-color: #2E3440;
    color: #D8DEE9;
    border: 1px solid #434C5E;
    border-radius: 4px;
    padding: 4px;
}

QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #88C0D0;
}

/* --- Tool Tip --- */
QToolTip {
    background-color: #434C5E;
    color: #ECEFF4;
    border: 1px solid #4C566A;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 12px;
}

/* --- Check Box / Radio Button --- */
QCheckBox, QRadioButton {
    color: #D8DEE9;
    spacing: 6px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #4C566A;
    background-color: #3B4252;
}

QCheckBox::indicator {
    border-radius: 3px;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:checked {
    background-color: #88C0D0;
    border-color: #88C0D0;
}

QRadioButton::indicator:checked {
    background-color: #88C0D0;
    border-color: #88C0D0;
}

/* --- Slider --- */
QSlider::groove:horizontal {
    background-color: #3B4252;
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: #88C0D0;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background-color: #81A1C1;
}

/* --- Custom: Trading Signal Colors --- */
QLabel#signalBuy {
    color: #A3BE8C;
    font-weight: bold;
}

QLabel#signalSell {
    color: #BF616A;
    font-weight: bold;
}

QLabel#signalHold {
    color: #EBCB8B;
    font-weight: bold;
}

/* --- Custom: Equity Positive / Negative --- */
QLabel#equityPositive {
    color: #A3BE8C;
}

QLabel#equityNegative {
    color: #BF616A;
}
